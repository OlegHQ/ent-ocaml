opam-version: "2.0"
synopsis: "MongoDB backend for ent-ocaml"
description: "ent-ocaml-mongo maps ent-ocaml typed query and mutation plans to MongoDB using the OCaml mongo/eio driver and BSON codecs."
maintainer: "OlegHQ"
authors: "OlegHQ"
license: "Apache-2.0"
homepage: "https://github.com/OlegHQ/ent-ocaml"
bug-reports: "https://github.com/OlegHQ/ent-ocaml/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.22"}
  "ent-ocaml"
  "eio"
  "bson"
  "mongo"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
