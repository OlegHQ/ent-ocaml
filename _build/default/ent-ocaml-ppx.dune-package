(lang dune 3.23)
(name ent-ocaml-ppx)
(sections (lib .) (libexec .) (doc ../../doc/ent-ocaml-ppx))
(files
 (lib
  (META
   dune-package
   ent_ocaml_ppx.a
   ent_ocaml_ppx.cma
   ent_ocaml_ppx.cmi
   ent_ocaml_ppx.cmt
   ent_ocaml_ppx.cmx
   ent_ocaml_ppx.cmxa
   ent_ocaml_ppx.ml
   ent_ocaml_ppx__Ppx_ent_ocaml.cmi
   ent_ocaml_ppx__Ppx_ent_ocaml.cmt
   ent_ocaml_ppx__Ppx_ent_ocaml.cmx
   opam
   ppx_ent_ocaml.ml))
 (libexec (ent_ocaml_ppx.cmxs ppx.exe))
 (doc (README.md)))
(library
 (name ent-ocaml-ppx)
 (kind ppx_rewriter)
 (archives (byte ent_ocaml_ppx.cma) (native ent_ocaml_ppx.cmxa))
 (plugins (byte ent_ocaml_ppx.cma) (native ent_ocaml_ppx.cmxs))
 (native_archives ent_ocaml_ppx.a)
 (requires ppxlib.ast ppxlib ent-ocaml)
 (main_module_name Ent_ocaml_ppx)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name ent_ocaml_ppx)
     (visibility public)
     (kind alias)
     (source (path Ent_ocaml_ppx) (impl (path ent_ocaml_ppx.ml-gen))))
    (name Ent_ocaml_ppx)
    (modules
     (module
      (obj_name ent_ocaml_ppx__Ppx_ent_ocaml)
      (visibility public)
      (source (path Ppx_ent_ocaml) (impl (path ppx_ent_ocaml.ml))))))
   (wrapped true))))
