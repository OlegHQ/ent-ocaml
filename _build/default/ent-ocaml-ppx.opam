opam-version: "2.0"
synopsis: "PPX generator for ent-ocaml entity clients"
description: "ent-ocaml-ppx generates entity-specific clients, predicates, builders, hooks, privacy plumbing, and backend bindings from typed OCaml schemas."
maintainer: "OlegHQ"
authors: "OlegHQ"
license: "Apache-2.0"
homepage: "https://github.com/OlegHQ/ent-ocaml"
bug-reports: "https://github.com/OlegHQ/ent-ocaml/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.22"}
  "ent-ocaml"
  "ppxlib"
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
